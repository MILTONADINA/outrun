# Data, models and logs are never committed (data/manifest.yaml is the exception).
# scenarios/ bundles (risk zarr stacks, shared graphs) ARE committed so a clean clone runs the offline demo.
data/*
!data/manifest.yaml
models/
logs/
*.mp4

# Python / tooling
.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# OS / editors
.DS_Store
.idea/
.vscode/
.claude/settings.local.json
cache/

# Static export output (built by CI)
_site/
